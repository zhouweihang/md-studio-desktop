{
  "version": 1,
  "bindings": {
    "file.new": ["CmdOrCtrl+N"],
    "file.open": ["CmdOrCtrl+O"],
    "file.openFolder": ["CmdOrCtrl+Alt+O"],
    "file.save": ["CmdOrCtrl+S"],
    "file.saveAs": ["CmdOrCtrl+Shift+S"],
    "file.close": ["CmdOrCtrl+W"],
    "file.newTab": ["CmdOrCtrl+T"],
    "tab.next": ["Ctrl+Tab"],
    "tab.prev": ["Ctrl+Shift+Tab"],
    "file.print": ["CmdOrCtrl+P"],
    "file.rename": ["F2"],
    "app.settings": ["CmdOrCtrl+comma"],
    "edit.find": ["CmdOrCtrl+F"],
    "edit.replace": ["CmdOrCtrl+H"],
    "edit.findNext": ["F3"],
    "edit.findPrev": ["Shift+F3"],
    "paragraph.h1": ["CmdOrCtrl+1"],
    "paragraph.h2": ["CmdOrCtrl+2"],
    "paragraph.h3": ["CmdOrCtrl+3"],
    "paragraph.h4": ["CmdOrCtrl+4"],
    "paragraph.h5": ["CmdOrCtrl+5"],
    "paragraph.h6": ["CmdOrCtrl+6"],
    "paragraph.paragraph": ["CmdOrCtrl+0"],
    "paragraph.quote": ["CmdOrCtrl+Shift+Q"],
    "paragraph.bulletList": ["CmdOrCtrl+Shift+U"],
    "paragraph.orderedList": ["CmdOrCtrl+Shift+O"],
    "paragraph.taskList": ["CmdOrCtrl+Shift+X"],
    "paragraph.codeBlock": ["CmdOrCtrl+Shift+C"],
    "paragraph.table": ["CmdOrCtrl+Shift+T"],
    "format.bold": ["CmdOrCtrl+B"],
    "format.italic": ["CmdOrCtrl+I"],
    "format.strikethrough": ["CmdOrCtrl+Shift+D"],
    "format.inlineCode": ["CmdOrCtrl+Shift+E"],
    "format.highlight": ["CmdOrCtrl+Shift+H"],
    "format.link": ["CmdOrCtrl+K"],
    "format.image": ["CmdOrCtrl+Shift+I"],
    "format.clear": ["CmdOrCtrl+\\"],
    "view.zoomIn": ["CmdOrCtrl+equal"],
    "view.zoomOut": ["CmdOrCtrl+minus"],
    "view.zoomReset": ["CmdOrCtrl+Shift+0"],
    "view.fullscreen": ["F11"],
    "view.source": ["CmdOrCtrl+/"],
    "view.focus": ["F8"],
    "view.typewriter": ["F9"],
    "view.sidebar": ["CmdOrCtrl+Shift+B"],
    "theme.toggle": ["CmdOrCtrl+Shift+Y"]
  }
}
